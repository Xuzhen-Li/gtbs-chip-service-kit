{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xuzhen-Li/gtbs-chip-service-kit/profiles/profile.schema.json",
  "title": "GBTSChipProfile",
  "type": "object",
  "required": ["profile_id", "label", "panel_n_sites"],
  "properties": {
    "profile_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "panel_n_sites": { "type": "integer", "minimum": 1 },
    "coordinate_system": { "type": "string" },
    "sites_bed": { "type": "string" },
    "panel_info": { "type": "string" },
    "dosage_cache": { "type": "string" },
    "admixture_family": { "type": "string" },
    "handin": {
      "type": "object",
      "properties": {
        "cloud": { "type": "string" },
        "suite": { "type": "string" }
      }
    },
    "walkthrough_url": { "type": "string" },
    "claims_doc": { "type": "string" }
  },
  "additionalProperties": true
}
